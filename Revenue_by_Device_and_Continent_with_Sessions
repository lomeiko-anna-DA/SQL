WITH
  revenue_usd AS (
    SELECT
      sp.continent,
      ROUND(SUM(p.price), 2) AS revenue,
      ROUND(SUM(CASE WHEN device = 'mobile' THEN p.price END), 2) AS revenue_from_mobile,
      ROUND(SUM(CASE WHEN device = 'desktop' THEN p.price END), 2) AS revenue_from_desktop,
      ROUND(SUM(p.price) / SUM(SUM(p.price)) OVER() * 100, 2) AS pct_revenue_from_total,
    FROM `DA.order` o
    JOIN `DA.product` p
    ON o.item_id = p.item_id
    JOIN `DA.session_params` sp
    ON o.ga_session_id = sp.ga_session_id
    GROUP BY sp.continent
  ),
  sessions_info AS (
    SELECT DISTINCT
      sp.continent,
      COUNT(ac.account_id) AS account_cnt,
      COUNT(CASE WHEN is_verified = 1 THEN a.id END) AS verified_account_cnt,
      COUNT(sp.ga_session_id) as session_cnt
    FROM `DA.session_params` sp
    LEFT JOIN `DA.account_session` ac
    ON sp.ga_session_id = ac.ga_session_id
    LEFT JOIN `DA.account` a
    ON a.id = ac.account_id
    GROUP BY sp.continent
  )

SELECT revenue_usd.continent,
  revenue_usd.revenue,
  revenue_usd.revenue_from_mobile,
  revenue_usd.revenue_from_desktop,
  revenue_usd.pct_revenue_from_total,
  sessions_info.account_cnt,
  sessions_info.verified_account_cnt,
  sessions_info.session_cnt
FROM sessions_info
LEFT JOIN revenue_usd
ON revenue_usd.continent = sessions_info.continent
